# Public base URL for the existing Next.js backend.
# On a physical phone, use your Mac's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Firebase client configuration from Firebase Console > Project settings > Your apps.
# These are public client settings, not Firebase Admin credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-app-id
